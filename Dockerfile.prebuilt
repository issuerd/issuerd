# Runtime-only image variant for prebuilt release binaries.
#
# The canonical root Dockerfile compiles inside the container (linux/amd64).
# Prebuilt platforms (linux/arm64, built natively on an ubuntu-22.04-arm
# GitHub runner by the release workflow's linux-arm64 job) are packaged with
# this file instead: the build context carries the binary plus its
# shared-library dependencies, so every step is a COPY and no foreign-arch
# code ever runs on the x86_64 docker-arm64 runner.
#
#   docker buildx build --platform linux/arm64 \
#     --build-arg RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot \
#     -f Dockerfile.prebuilt -t issuerd:arm64 <build-context>
#
# <build-context> layout (staged by the release job;
# scripts/cross-linux-arm64.sh produces the same layout for local x86_64
# builds):
#   issuerd                                   the aarch64 binary
#   rootfs/usr/lib/<triplet>/lib*.so*         Kerberos/GSS-API runtime libs
#                                             (distroless/cc covers glibc +
#                                             libssl3 + ca-certificates)
#
# Keep ENTRYPOINT/CMD in sync with the canonical Dockerfile.

ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot
FROM ${RUNTIME_IMAGE}

COPY rootfs/ /
# --chmod is mandatory: the release workflow stages this build context through
# actions/upload-artifact + download-artifact, which drop the executable bit.
COPY --chmod=0755 issuerd /usr/local/bin/issuerd

# The :nonroot distroless tag already runs as uid 65532.
EXPOSE 8080

ENTRYPOINT ["issuerd"]
CMD ["daemon", "-c", "/etc/issuerd/issuerd.toml"]
