{
  "name": "issuerd-mcp-admin-acceptance",
  "version": "0.0.0",
  "private": true,
  "description": "External read-only MCP and DPoP acceptance client for Issuerd lab rigs",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=11.13.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "setup": "node dist/src/setup.js",
    "start": "node dist/src/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
