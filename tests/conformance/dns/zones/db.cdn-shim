$TTL 60
; Generic zone for the CDN hostnames the conformance suite's web UI references
; (see cdn-shim/). One shared file: all records are relative (@ expands to the
; zone name), so every shimmed hostname zone can point here.
@   IN  SOA ns.conformance.test. admin.conformance.test. (
        2026091901 ; Serial
        3600       ; Refresh
        1800       ; Retry
        604800     ; Expire
        60         ; Minimum TTL
)

@       IN  NS  ns.conformance.test.

; Everything at the zone apex resolves to the cdn-shim container
; (static IP, must match docker-compose.yml).
@       IN  A   172.31.0.15
